# Netlify _headers — applied to the deployed site

# ── Hero images & all public assets: cache for 1 year ───────────────────────
# Netlify deploys these with the same filename, so we use immutable only for
# the hashed JS/CSS bundles. For images we use a long max-age with must-revalidate.
/DSC_0001.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/DSC_0002.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/DSC_0003.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/DSC_0004.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/DSC_0006.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/DSC_0811.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/choir.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/grp1.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/yg2.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/yg3.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/yr.jpg
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/crest.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/logo.svg
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/banner.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# ── Vite-hashed JS/CSS bundles: truly immutable ──────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── HTML: always revalidate so new deploys are picked up instantly ────────────
/*
  Cache-Control: public, max-age=0, must-revalidate
